{
  "name": "scriptor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "dev:diag": "npx vite --mode diagnostic",
    "init-diag-help": "node scripts/init-diag-help.mjs",
    "vite:dev:1420": "npx kill-port 14230 && npx vite --port 14230 --strictPort",
    "ia:spring-boot": "cd ../backend && powershell -ExecutionPolicy Bypass -File .\\run-backend.ps1",
    "dev:tauri": "node scripts/dev-tauri.cjs",
    "dev:tauri:full": "npx concurrently -k -n spring,tauri -c yellow,cyan \"npm run ia:spring-boot\" \"npm run dev:tauri\"",
    "build": "npx vite build",
    "lint": "eslint .",
    "preview": "npx vite preview",
    "tauri": "npx @tauri-apps/cli",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "tauri-dev": "npm run tauri:dev",
    "tauri:build": "npx @tauri-apps/cli build",
    "tauri-build": "npm run tauri:build",
    "tauri:dist": "npm run tauri:build && node scripts/tauri-dist-info.mjs",
    "tauri:dist-info": "node scripts/tauri-dist-info.mjs",
    "stress:test": "node scripts/stress-test.mjs",
    "stress:backup": "node scripts/stress-backup.mjs",
    "stress:all": "node scripts/stress-all.mjs",
    "stress:suite": "node scripts/stress-suite.mjs",
    "security:audit": "node scripts/audit-gate.mjs",
    "cdc:gate": "node scripts/cdc-gate.mjs",
    "test:pdf-reconstruct": "node scripts/pdf-reconstruct-selftest.mjs",
    "extract:corrector-sources": "node scripts/extract-corrector-sources.mjs",
    "vendor:gramalecte-fr": "node scripts/vendor-gramalecte-fr.mjs",
    "vendor:gramalecte-fr:refresh": "node scripts/vendor-gramalecte-fr.mjs --download",
    "build:corrector-corpus-index": "node scripts/build-corrector-corpus-index.mjs",
    "corpus:rebuild": "npm run extract:corrector-sources && npm run build:corrector-corpus-index",
    "lt:server": "node scripts/start-languagetool.mjs",
    "vendor:languagetool-bundled": "node scripts/vendor-languagetool-bundled.mjs",
    "epubcheck": "node scripts/run-epubcheck.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-log": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tensorflow/tfjs": "^4.22.0",
    "docx": "^9.6.1",
    "fuse.js": "^7.1.0",
    "hyphenation.en-us": "^0.2.1",
    "hyphenation.fr": "^0.2.1",
    "hypher": "^0.2.5",
    "jszip": "^3.10.1",
    "lcms-wasm": "^1.0.5",
    "mammoth": "^1.12.0",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "pdfmake": "^0.3.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kill-port": "^2.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.3.1"
  }
}
